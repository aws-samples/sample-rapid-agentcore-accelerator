# Streamlit Frontend Environment Variables
# Copy this file to .env and fill in values from CDK stack outputs

# =============================================================================
# OPTION 1: Connect to AgentCore Runtime (deployed agent)
# =============================================================================
# AgentCore Runtime (from CDK outputs)
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:XXXXXXXXXXXX:runtime/strands_agent

# =============================================================================
# OPTION 2: Connect to locally running agent
# =============================================================================
# When set, the frontend will connect to a local agent instead of AgentCore Runtime
# Start your agent locally first, from the repository root. For the
# customer-support sample: make docker-run AGENT=customer-support
# LOCAL_AGENT_URL=http://localhost:8080

# =============================================================================
# Common Settings
# =============================================================================
# AWS Region
AWS_REGION=us-west-2

# Enable streaming mode for real-time agent responses
# When enabled, agent responses stream incrementally with tool usage displayed in expanders
# Set to 'true' to enable, 'false' or omit to disable (default: false)
STREAMING_ENABLED=false

# Note: Authentication is automatically determined based on configuration:
# - LOCAL_AGENT_URL set: Direct HTTP (no auth)
# - COGNITO_AUTH_ENABLED=true: OAuth (set by CDK)
# - Otherwise: IAM authentication with your AWS credentials
